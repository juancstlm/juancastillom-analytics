# Postgres password for the umami database user
DB_PASSWORD=changeme

# Long random string used by Umami to sign sessions
# Generate with: openssl rand -base64 48
APP_SECRET=generate-long-random-string

# Cloudflare Zero Trust tunnel token
# Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> create -> copy token
TUNNEL_TOKEN=from-cloudflare-zero-trust

# Tracker script filename. Rename to dodge adblockers that match /script.js
# The frontend snippet must load /<TRACKER_SCRIPT_NAME>.js
TRACKER_SCRIPT_NAME=script
